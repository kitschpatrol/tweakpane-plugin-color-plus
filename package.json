{
	"name": "tweakpane-plugin-color-plus",
	"version": "0.6.2",
	"description": "Advanced color handling for Tweakpane.",
	"keywords": [
		"color",
		"npm-package",
		"tweakpane",
		"tweakpane-plugin"
	],
	"homepage": "https://github.com/kitschpatrol/tweakpane-plugin-color-plus",
	"bugs": "https://github.com/kitschpatrol/tweakpane-plugin-color-plus/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/tweakpane-plugin-color-plus.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/tweakpane-plugin-color-plus.js"
		},
		"./lite": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/tweakpane-plugin-color-plus.lite.js"
		}
	},
	"main": "dist/tweakpane-plugin-color-plus.js",
	"types": "dist/types/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "run-p build:*",
		"build:dev": "tsdown",
		"build:dts": "shx rm -rf ./dist/types && tsc --project tsconfig.dts.json",
		"build:prod": "cross-env BUILD=production tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "vite",
		"dev:cdn": "poptab && vite ./demo/cdn --open",
		"dev:npm": "poptab && vite ./demo/npm --open",
		"dev:playground": "poptab && vite ./demo/playground --open",
		"dev:screenshot": "poptab && vite ./demo/screenshot --open",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' --tag '%s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"start": "run-p watch dev",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"watch": "run-p watch:*",
		"watch:dts": "onchange --initial --kill \"src/**/*.ts\" -- pnpm build:dts",
		"watch:sass": "onchange --initial --kill \"src/sass/**/*.scss\" -- pnpm build:dev",
		"watch:ts": "onchange --initial --kill \"src/**/*.ts\" -- pnpm build:dev"
	},
	"dependencies": {
		"@tweakpane/core": "^2.0.5"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.12.1",
		"@types/node": "~22.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"autoprefixer": "^10.6.1",
		"bumpp": "^12.3.0",
		"colorjs.io": "^0.7.1",
		"cross-env": "^10.1.0",
		"npm-run-all": "^4.1.5",
		"onchange": "^7.1.0",
		"poptab": "^1.2.1",
		"postcss": "^8.5.29",
		"sass": "^1.105.1",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsdown": "^0.23.0",
		"tweakpane": "^4.0.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"tweakpane": "^4.0.0"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^22.0.0 || ^24.0.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.16.0"
		}
	}
}
