{
	"name": "tweakpane-plugin-color-plus",
	"version": "0.7.1",
	"description": "Advanced color handling for Tweakpane.",
	"keywords": [
		"color",
		"npm-package",
		"tweakpane",
		"tweakpane-plugin"
	],
	"homepage": "https://github.com/kitschpatrol/tweakpane-plugin-color-plus",
	"bugs": "https://github.com/kitschpatrol/tweakpane-plugin-color-plus/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/tweakpane-plugin-color-plus.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/tweakpane-plugin-color-plus.d.ts",
			"default": "./dist/tweakpane-plugin-color-plus.js"
		},
		"./lite": {
			"types": "./dist/tweakpane-plugin-color-plus.d.ts",
			"default": "./dist/tweakpane-plugin-color-plus.lite.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/tweakpane-plugin-color-plus.js",
	"module": "./dist/tweakpane-plugin-color-plus.js",
	"types": "./dist/tweakpane-plugin-color-plus.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"dev": "vite",
		"dev:cdn": "vite --open /demo/cdn/",
		"dev:npm": "pnpm build && vite --open /demo/npm/",
		"dev:playground": "vite --open /demo/playground/",
		"dev:screenshot": "vite --open /demo/screenshot/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' --tag '%s' --all --execute 'chagent' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"watch": "tsdown --watch"
	},
	"dependencies": {
		"@tweakpane/core": "^2.0.5",
		"colorjs.io": "^0.7.1"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/chagent": "^0.5.0",
		"@kitschpatrol/shared-config": "^8.14.1",
		"@tsdown/css": "0.23.4",
		"@types/node": "~22.12.0",
		"@vitest/coverage-v8": "^5.0.5",
		"bumpp": "^12.3.0",
		"happy-dom": "^21.0.4",
		"publint": "^0.3.25",
		"sass": "^1.107.1",
		"shx": "^0.4.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"tsdown": "0.23.4",
		"tweakpane": "^4.0.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"tweakpane": "^4.0.0"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^22.0.0 || ^24.0.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	}
}
